@echo off
:: ===============================================================================
:: [Code2PPTX] 自動実行バッチスクリプト
:: system/main_code2pptx.py を一括起動し、文字化け防止・環境チェック・結果確認を行います。
:: ===============================================================================
chcp 65001 > nul
setlocal

:: カレントディレクトリを実行スクリプトのあるフォルダへ変更
cd /d "%~dp0"

echo ===============================================================================
echo 【Code2PPTX】 一括自動実行パイプラインを開始します
echo ===============================================================================
echo.

:: 1. Python実行環境の存在確認
where python >nul 2>&1
if %ERRORLEVEL% neq 0 (
    echo [エラー] Pythonがインストールされていないか、PATHが通っていません。
    echo Pythonをインストール後、再度実行してください。
    echo.
    pause
    exit /b 1
)

:: 2. メインパイプラインスクリプトの存在確認
if not exist "main_code2pptx.py" (
    echo [エラー] system\main_code2pptx.py が見つかりません。
    echo 実行場所（フォルダ構成）を確認してください。
    echo.
    pause
    exit /b 1
)

:: 3. 入力フォルダ(inputs)の確認・作成
if not exist "inputs" (
    mkdir "inputs"
    echo [情報] inputs フォルダを作成しました。
    echo 解析対象の .py ファイルを inputs フォルダ内に配置してください。
    echo.
    pause
    exit /b 0
)

:: 4. メインパイプラインの実行
echo ▶ main_code2pptx.py を実行中...
echo -------------------------------------------------------------------------------
python main_code2pptx.py

set EXIT_CODE=%ERRORLEVEL%
echo -------------------------------------------------------------------------------
echo.

:: 5. 実行結果判定
if %EXIT_CODE% equ 0 (
    echo ===============================================================================
    echo [成功] レポートの自動生成処理が正常に完了しました！
    echo 成果物出力先: outputs フォルダ
    echo ===============================================================================
) else (
    echo ===============================================================================
    echo [エラー] 処理途中でエラーが発生しました（終了コード: %EXIT_CODE%）。
    echo 上記のログメッセージを確認してください。
    echo ===============================================================================
)

echo.
pause